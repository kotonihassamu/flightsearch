# ローカル実行用（要件4.4）。このファイルをコピーして .env を作る。
# .env は .gitignore 済み。値は絶対にコミット・共有しない。
#
#   copy .env.example .env
#   notepad .env
#
# 既存の環境変数（GitHub Secrets）がある場合はそちらが優先される。

# LINE Developers > 対象チャネル > 「Messaging API設定」タブ
#   > チャネルアクセストークン（長期） > 「発行」
# ※「チャネルシークレット」ではない。本システムはシークレットを使わない。
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Developers > 対象チャネル > 「チャネル基本設定」タブ
#   > 一番下の「あなたのユーザーID」（U で始まる33文字）
LINE_TO_USER_ID=

# 任意: 設定ファイルのパス上書き
# FLIGHTDEAL_CONFIG=./config.json

# 任意: 障害調査用HTMLの保存先（既定 ./artifacts）
# FLIGHTDEAL_ARTIFACT_DIR=./artifacts
